from pptx import Presentation
from pptx.dml.color import RGBColor
from pptx.enum.shapes import MSO_SHAPE
from pptx.enum.text import MSO_ANCHOR, PP_ALIGN
from pptx.util import Inches, Pt

# Initialize Presentation & 16:9 Widescreen Canvas
prs = Presentation()
prs.slide_width = Inches(13.333)
prs.slide_height = Inches(7.5)

# Executive Slate Palette
PALETTE = {
    'bg': RGBColor(0xF4, 0xF6, 0xF8),  # Light Slate
    'header': RGBColor(0x1E, 0x29, 0x3B),  # Dark Slate
    'accent': RGBColor(0x25, 0x63, 0xEB),  # Royal Blue
    'text': RGBColor(0x33, 0x41, 0x55),  # Charcoal
    'card_bg': RGBColor(0xFF, 0xFF, 0xFF),  # White
}


def add_slide_header(slide, title_text, category_text=''):
  """Creates styled header zone with accent bar."""
  tb = slide.shapes.add_textbox(
      Inches(0.8), Inches(0.4), Inches(11.733), Inches(0.9)
  )
  tf = tb.text_frame
  tf.word_wrap = True

  if category_text:
    p_cat = tf.paragraphs
    p_cat.text = category_text.upper()
    p_cat.font.size = Pt(10)
    p_cat.font.bold = True
    p_cat.font.color.rgb = PALETTE['accent']

  p_title = tf.add_paragraph() if category_text else tf.paragraphs
  p_title.text = title_text
  p_title.font.size = Pt(22)
  p_title.font.bold = True
  p_title.font.color.rgb = PALETTE['header']


# (Additional slide functions for cards, tables, and code trees...)
prs.save('/workspace/out/mrp_presentation.pptx')
